# post-BFF (SvelteKit): aggregiert mail-api + briefkasten.
MAIL_API_BASE_URL=http://saganta-mail-api:8000
SAGANTA_BACKEND_SECRET=change-me-shared-with-shell
# Briefkasten interne API (statischer Bearer = KG_INTERNAL_TOKEN des briefkasten-Containers).
BRIEFKASTEN_BASE_URL=http://briefkasten:8000
BRIEFKASTEN_INTERNAL_TOKEN=change-me-equals-briefkasten-KG_INTERNAL_TOKEN

AUTH_SERVICE_URL=http://saganta-auth:3000
AUTH_LOGIN_URL=https://example.com/login
AUTH_COOKIE_NAME=saganta.session_token

# Owner-Gate: kommaseparierte sub-Allowlist. briefkasten ist single-tenant
# (kein per-User-Schema) → ohne ALLOWED_SUBS sähe jeder verifizierte Account die
# Briefdaten des Owners. Leer = offen (nur Dev). Entfällt in der Multiuser-Phase.
ALLOWED_SUBS=change-me-owner-sub

HOST=0.0.0.0
PORT=3000
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
