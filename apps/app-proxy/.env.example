# Generischer auth-gating Reverse-Proxy (SvelteKit). Ein Image, pro gehosteter
# App ein Container mit eigenem BACKEND_URL + ORIGIN.
APP_NAME=saganta-fitness
BACKEND_URL=http://fitness:8000

# Auth: zentraler saganta-auth-Service (better-auth). Keine Login-UI hier:
# unauthentifiziert -> Redirect auf shell /login (absolute URL).
AUTH_SERVICE_URL=http://saganta-auth:3000
AUTH_LOGIN_URL=https://example.com/login
AUTH_COOKIE_NAME=saganta.session_token

HOST=0.0.0.0
PORT=3000
# Hinter dem Edge (dev-portal): ORIGIN NICHT setzen, sonst CSRF-/Origin-403.
# adapter-node rekonstruiert die URL aus diesen Forwarded-Headern.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
