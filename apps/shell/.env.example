# Auth: eigener saganta-auth-Service (better-auth). Ersetzt OIDC/Authelia/Zitadel.
# Interne URL (server-to-server über cc-core) für Session-Validierung:
AUTH_SERVICE_URL=http://saganta-auth:3000
# Öffentliche Login-Seite (im shell). Andere Apps zeigen absolut hierher:
AUTH_LOGIN_URL=/login
#   andere Apps z. B.: AUTH_LOGIN_URL=https://example.com/login
# better-auth Session-Cookie-Name (muss zum auth-service cookiePrefix passen):
AUTH_COOKIE_NAME=saganta.session_token

# Backend-Endpoints (über cc-core Docker-Netz)
#
# LIFEOPS_BASE_URL schaltet das Homelab-Briefing auf der Startseite frei (nur
# fuer OWNER_SUB). Es braucht ein life-ops-api, das dieses Repo NICHT mitliefert.
# Leer lassen, wer keins betreibt: die Startseite laesst den Abschnitt dann
# einfach weg. Eingetragen ohne Backend dahinter ergibt einen fehlgeschlagenen
# Aufruf je Seitenaufruf, den nur das Protokoll zeigt.
LIFEOPS_BASE_URL=
SHELL_API_BASE_URL=http://saganta-shell-api:8000
SAGANTA_BACKEND_SECRET=change-me-shared-with-auth-proxy

# Briefkasten-Stats fürs Owner-Dashboard (aktive Briefe → Badge). Interne API,
# STATISCHER Bearer = KG_INTERNAL_TOKEN des briefkasten-Containers (kein JWT!).
BRIEFKASTEN_BASE_URL=http://briefkasten:8000
BRIEFKASTEN_INTERNAL_TOKEN=change-me-equals-briefkasten-KG_INTERNAL_TOKEN
# Owner-sub (nur der Owner sieht Homelab-Briefing + briefkasten-Stats).
# Ohne diesen Wert ist NIEMAND Owner, das ist fail-closed und gewollt.
# Eintragen mit scripts/owner-kennung-eintragen.sh (liest die Kennung aus der
# Auth-Datenbank, statt sie abschreiben zu lassen).
OWNER_SUB=change-me-owner-sub

# Basis-Domaene dieser Installation, ohne Schema und ohne Unterdomaene.
# Daraus baut apps/shell/src/lib/catalog.ts die Adressen der einzelnen Apps
# (https://kalender.<domaene> und so weiter). Bis 2026-09-06 stand dort
# "saganta.de" fest im Quelltext, was fuer jede andere Installation lauter tote
# Links auf eine fremde Instanz bedeutete.
# Ohne diesen Wert bleiben die App-Kacheln auf /apps unverlinkt.
PUBLIC_SAGANTA_DOMAIN=example.com
# Kontaktadresse fuer die "Business"-Anfrage auf der Preisseite. Leer = kein Link.
PUBLIC_SAGANTA_KONTAKT=

# Node
HOST=127.0.0.1
PORT=8200
ORIGIN=https://shell.example.com
