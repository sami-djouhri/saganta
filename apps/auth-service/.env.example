# --- better-auth Kern ---
# 32+ Zeichen. Erzeugen: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-min-32-chars
# Öffentliche Basis-URL des Auth-Service (Produkt):
BETTER_AUTH_URL=https://auth.example.com

# --- Datenbank (eigene Postgres saganta-auth-db) ---
DATABASE_URL=postgres://saganta_auth:change-me@saganta-auth-db:5432/saganta_auth

# --- Cross-Subdomain-SSO ---
# Root-Domain, damit das Cookie über alle Subdomains gilt:
AUTH_COOKIE_DOMAIN=example.com
# Erlaubte Origins (CSRF/Cookie-Validierung).
# WICHTIG: Die interne AUTH_SERVICE_URL-Origin (z. B. http://saganta-auth:3000) MUSS
# enthalten sein, die BFFs weisen sich bei server-to-server sign-in/up/out mit diesem
# Origin aus (better-auth verlangt einen trusted Origin, sonst „Missing or null Origin").
AUTH_TRUSTED_ORIGINS=http://saganta-auth:3000,https://example.com,https://shell.example.com,https://news.example.com,https://kalender.example.com,https://assets.example.com

# --- Server ---
HOST=0.0.0.0
PORT=3000

# Nur lokale http-Entwicklung (sonst weglassen → Secure-Cookies):
# AUTH_INSECURE_COOKIES=true
