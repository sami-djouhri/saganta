# news-BFF (SvelteKit). Auth-Vars werden von @saganta/auth loadAuthConfig() gelesen.
NEWS_API_BASE_URL=http://saganta-news-api:8000
# SAGANTA_BACKEND_SECRET muss identisch zum shared HS256-Secret von shell/shell-api sein.
SAGANTA_BACKEND_SECRET=change-me-shared-with-shell

# Auth: zentraler saganta-auth-Service (better-auth). Keine Login-UI hier:
# unauthentifiziert → Redirect auf shell /login (absolute URL).
AUTH_SERVICE_URL=http://saganta-auth:3000
AUTH_LOGIN_URL=https://example.com/login
AUTH_COOKIE_NAME=saganta.session_token

HOST=0.0.0.0
PORT=3000
ORIGIN=https://news.home.arpa
