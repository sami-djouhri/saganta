# Shared Secrets (werden via SOPS verschlüsselt im Repo abgelegt: siehe vault/).
# Beim Deploy entschlüsselt scripts/deploy.sh in die jeweiligen App/Service-.env-Files.

SAGANTA_BACKEND_SECRET=change-me-32-chars-or-more
AUTHELIA_CLIENT_SECRET_SHELL=change-me
AUTHELIA_CLIENT_SECRET_CALENDAR=change-me
AUTHELIA_CLIENT_SECRET_MAIL=change-me

# Übernommen aus bestehenden Homelab-Services
KALENDER_INTERNAL_TOKEN=<aus /home/user/docker/postfach/.env KG_INTERNAL_TOKEN>
BRIEFKASTEN_INTERNAL_TOKEN=<aus /home/user/docker/postfach/.env>
LIFEOPS_INTERNAL_TOKEN=<aus /home/user/docker/life-ops-api/.env>

# Cloudflare Tunnel: erst für Phase 2 nötig
CLOUDFLARED_TOKEN=

# Zitadel ist seit 2026-06-27 abgeloest (better-auth, apps/auth-service).
# Der Block stand hier bis 2026-09-06 weiter drin, ohne Container und ohne
# einen einzigen Leser im Quelltext. In einer Beispieldatei ist so etwas nicht
# bloss Ballast: wer sie liest, richtet einen Dienst ein, den es nicht gibt.
