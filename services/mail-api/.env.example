DATABASE_URL=sqlite:////data/mail.db
# Sync-Poller: wie oft alle aktiven Konten per IMAP abgefragt werden
SYNC_INTERVAL_SECONDS=300
IMAP_FETCH_TIMEOUT=20.0
# Wie viele der neuesten Nachrichten pro Konto/Ordner je Sync geholt werden (Header/Snippet)
SYNC_MAX_MESSAGES=200
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
# FERNET_KEY: 32-Byte urlsafe-base64 Key zum Verschlüsseln der IMAP/SMTP-Passwörter at-rest.
# Erzeugen: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUSS stabil bleiben (Rotation = alle gespeicherten Account-Passwörter neu eingeben).
FERNET_KEY=change-me-generate-a-real-fernet-key
# JWT_SECRET muss identisch zum shared HS256-Secret von shell-api/auth-proxy sein (NICHT neu generieren)
JWT_SECRET=change-me-shared-with-auth-proxy
JWT_ALGORITHM=HS256
# Die Oberflaeche zu diesem Backend ist `apps/post` unter post.<domaene>.
# `postfach.<domaene>` stand hier bis 2026-09-12 und gehoerte zu `apps/mail`,
# das nicht deployt ist: ein Ursprung ohne Vhost dahinter.
CORS_ORIGINS=https://shell.home.arpa,https://post.home.arpa
