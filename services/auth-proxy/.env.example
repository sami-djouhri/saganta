JWT_SECRET=change-me-shared-with-bffs
JWT_ALGORITHM=HS256

# life-ops-api ist (Phase 1) ungeschützt auf cc-core. Token leer lassen.
#
# Dieses Repo liefert life-ops NICHT mit. Wer es nicht betreibt, laesst die
# Adresse LEER: der Proxy antwortet auf /lifeops/* dann mit 503 "nicht
# konfiguriert", statt in einen DNS-Fehler zu laufen. Eingetragen gehoert hier
# nur, was es in dieser Installation wirklich gibt.
LIFEOPS_BASE_URL=
LIFEOPS_INTERNAL_TOKEN=

# Kalender: nutzt FEED_TOKEN aus der Kalender-DB (Setting "feed_token").
# Phase-1-Setup: auf host abfragen mit
#   docker exec kalender python3 -c "import sqlite3;c=sqlite3.connect('/app/data/kalender.db');print(c.execute('SELECT value FROM settings WHERE key=\"feed_token\"').fetchone()[0])"
KALENDER_BASE_URL=http://kalender:8085
KALENDER_FEED_TOKEN=set-from-kalender-db
KALENDER_TOKEN_TTL_HOURS=23

# Briefkasten: Phase 1 deaktiviert (kein voller Read-Through-API).
BRIEFKASTEN_BASE_URL=http://briefkasten:8000
BRIEFKASTEN_INTERNAL_TOKEN=

TIMEOUT_SECONDS=10
