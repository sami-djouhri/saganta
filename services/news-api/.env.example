DATABASE_URL=sqlite:////data/news.db
POLL_INTERVAL_SECONDS=900
FEED_FETCH_TIMEOUT=10.0
DEFAULT_FEED_PAGE_SIZE=30
MAX_FEED_PAGE_SIZE=100
# SEED_FEEDS: JSON-Liste [{"slug","name","feed_url"}]; leer => eingebaute Defaults (Tagesschau/DLF/heise)
SEED_FEEDS=
# JWT_SECRET muss identisch zum shared HS256-Secret von shell-api/auth-proxy sein (NICHT neu generieren)
JWT_SECRET=change-me-shared-with-auth-proxy
JWT_ALGORITHM=HS256
CORS_ORIGINS=https://shell.home.arpa,https://news.home.arpa
# ALLOWED_SUBS leer lassen für Multiuser-Briefing (jeder eingeloggte Saganta-User).
# Nur setzen, wenn die News-/Briefing-Daten bewusst owner-only bleiben sollen.
ALLOWED_SUBS=
# ADMIN_SUBS: better-auth-subs, die Pro vergeben (/admin/set-plan) UND On-Demand-
# Briefings erzeugen dürfen (/admin/generate). Leer => beide Admin-Routen aus.
ADMIN_SUBS=

# ── Briefing (Multiuser) ────────────────────────────────────────────────────
# Öffentliche Basis-URL des news-Frontends (für absolute Podcast-Enclosure-URLs).
PUBLIC_BASE_URL=https://news.example.com
# 2 UTC = 04:00 CEST, VOR dem Morgen-Playback (05:00-08:00), damit das MP3 fertig ist.
BRIEFING_GENERATE_HOUR_UTC=2
BRIEFING_RETENTION_DAYS=7
BRIEFING_WINDOW_HOURS=30
BRIEFING_MAX_ITEMS=12
BRIEFING_MAX_SAME_SOURCE=2

# LLM-Gateway (LiteLLM, OpenAI-Format). Leer => keine LLM-Redaktion (Soft-Fail).
LLM_GATEWAY_URL=http://host.lan:8128
LLM_GATEWAY_KEY=
LLM_MODEL=homelab-fast
LLM_TIMEOUT=90.0

# TTS (Coqui XTTS, dediziertes LXC 101). Leer => kein Audio (Soft-Fail).
# TTS_SPEAKER = registrierter speaker_wav des XTTS (NICHT der Wyoming-Name "Sofia Hellen"
# → der ergibt am /api/tts-Endpunkt 500).
# Sprachausgabe fuers Briefing, optional. Leer = nur Text (Soft-Fail).
# Die eigene Adresse eintragen, dieses Repo liefert keinen TTS-Dienst mit.
TTS_URL=
TTS_SPEAKER=stimme-de-frau.wav
TTS_LANGUAGE=de
TTS_TIMEOUT=180.0
AUDIO_DIR=/data/briefing_audio

WEBHOOK_TIMEOUT=10.0

# ── Stripe (Self-Service-Pro-Abo) ───────────────────────────────────────────
# Leer lassen => Stripe AUS (Checkout gibt 503, Owner vergibt Pro via /admin/set-plan).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_SUCCESS_URL=https://news.example.com/briefing/upgrade/success
STRIPE_CANCEL_URL=https://news.example.com/briefing/upgrade/cancel
