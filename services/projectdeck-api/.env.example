DATABASE_URL=sqlite:////data/projectdeck.db
JWT_SECRET=change-me-shared-with-auth-proxy
JWT_ALGORITHM=HS256
CORS_ORIGINS=https://shell.home.arpa,https://projectdeck.home.arpa

# Native Kalender (cc-apps). LAN-Fallback: http://<wirt>:8085
KALENDER_BASE_URL=http://kalender:8085
KALENDER_FEED_TOKEN=change-me
KALENDER_TIMEOUT_SECONDS=8.0

# Optionaler KI-Layer. Default node2-Gemma (alltag-Pfad). Aus = reiner Regel-Fallback.
LLM_ENABLED=false
# Nur noetig bei LLM_ENABLED=true. Eigene Adresse eines OpenAI-kompatiblen
# /v1/chat/completions eintragen; leer bedeutet aus.
LLM_BASE_URL=
LLM_MODEL=gemma-3-4b
LLM_TIMEOUT_SECONDS=30.0
